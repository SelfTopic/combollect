{
	"name": "combollect",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/content && tsc --noEmit -p packages/journal && tsc --noEmit -p tools/sim && tsc --noEmit -p .",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "pnpm typecheck && pnpm lint && pnpm test",
		"sim": "tsx tools/sim/src/main.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^24.19.2",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild"
		]
	}
}
