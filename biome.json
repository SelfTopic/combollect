{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!**/*.md"]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noDefaultExport": "error",
				"noEnum": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/core/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedGlobals": {
							"level": "error",
							"options": {
								"deniedGlobals": {
									"window": "Ядро не знает об окружении.",
									"document": "Ядро не знает об окружении.",
									"process": "Ядро не знает об окружении.",
									"setTimeout": "Таймеры — только в локальном времени сущности.",
									"setInterval": "Таймеры — только в локальном времени сущности.",
									"Date": "Время — только world.tick и локальные часы.",
									"performance": "Время — только world.tick и локальные часы."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["vitest.config.ts"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
